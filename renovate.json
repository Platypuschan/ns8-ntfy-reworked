{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "ntfy runtime image pinned in build-images.sh and named in the README",
      "managerFilePatterns": ["/^build-images\\.sh$/", "/^README\\.md$/"],
      "matchStrings": [
        "NTFY_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"",
        "docker\\.io/binwiederhier/ntfy:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "docker.io/binwiederhier/ntfy",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Node.js builder image used by build-images.sh",
      "managerFilePatterns": ["/^build-images\\.sh$/"],
      "matchStrings": [
        "NODE_IMAGE=\"docker\\.io/library/node:(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "ntfy minor/patch releases: merge automatically once all CI checks (incl. QEMU install/update tests) are green",
      "matchDepNames": ["docker.io/binwiederhier/ntfy"],
      "commitMessageTopic": "ntfy",
      "minimumReleaseAge": "3 days",
      "bumpVersions": [
        {
          "name": "Raise the module catalog version",
          "filePatterns": ["CATALOG_VERSION"],
          "matchStrings": ["^(?<version>\\d+\\.\\d+\\.\\d+)\\s*$"],
          "bumpType": "{{#if isPatch}}patch{{else}}minor{{/if}}"
        }
      ]
    },
    {
      "matchDepNames": ["docker.io/binwiederhier/ntfy"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Major ntfy releases always need a manual review",
      "matchDepNames": ["docker.io/binwiederhier/ntfy"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "One Node.js PR for builder image, UI Containerfile and CI; stay on the current major",
      "matchDepNames": ["node"],
      "groupName": "Node.js",
      "bumpVersions": [
        {
          "name": "Raise the module catalog version",
          "filePatterns": ["CATALOG_VERSION"],
          "matchStrings": ["^(?<version>\\d+\\.\\d+\\.\\d+)\\s*$"],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "UI dependencies are part of the module image: one grouped PR, version bump; major upgrades (Vue 3, Vite 8, ...) are migrations and stay manual",
      "matchManagers": ["npm"],
      "groupName": "UI dependencies",
      "bumpVersions": [
        {
          "name": "Raise the module catalog version",
          "filePatterns": ["CATALOG_VERSION"],
          "matchStrings": ["^(?<version>\\d+\\.\\d+\\.\\d+)\\s*$"],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "GitHub Actions do not change the module image",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Runner images and the dev container are not updated automatically across majors",
      "matchDepNames": ["ubuntu", "mcr.microsoft.com/devcontainers/javascript-node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
