# Move ntfy data of releases before the ntfy-data volume into the volume.
# ntfy-app.service does the same before every start (bin/migrate-data-volume);
# this step also covers a service that is running while the module updates.

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import ntfy_migration


def systemctl(*args, check=True):
    return subprocess.run(("systemctl", "--user") + args, check=check)


if not ntfy_migration.legacy_names():
    sys.exit(0)

# Stop ntfy so SQLite files are closed and checkpointed before moving them.
# Stop unconditionally: while the upstream module crash-loops, ntfy is often
# "activating" rather than active, and a start in progress (including its
# ExecStartPre migration) must not run concurrently with this step.
start_again = (
    systemctl("is-active", "--quiet", "ntfy.service", check=False).returncode == 0
    or systemctl("is-enabled", "--quiet", "ntfy.service", check=False).returncode == 0
)
systemctl("stop", "ntfy.service", "ntfy-app.service")

try:
    # Recompute: a start of ntfy-app may have moved some data meanwhile.
    ntfy_migration.move_legacy_data(ntfy_migration.legacy_names())
finally:
    # A service updated from the original module may have crash-looped
    # on invalid legacy NTFY_* values and hit its start rate limit.
    systemctl("reset-failed", "ntfy.service", "ntfy-app.service", check=False)
    if start_again:
        systemctl("daemon-reload", check=False)
        # The data is already in place: a start failure must not fail the
        # update, configure-module and later restarts start ntfy again.
        if systemctl("start", "ntfy.service", check=False).returncode != 0:
            print("<4>ntfy.service did not start after the data migration", file=sys.stderr)
