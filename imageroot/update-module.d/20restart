# If the control reaches this step, the service can be enabled and started

set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# The core has already reloaded the unit files of the new release
# (update-module/05pullimages); reloading again is harmless and keeps the
# hook usable on its own.
systemctl --user daemon-reload
systemctl --user try-restart ntfy.service
