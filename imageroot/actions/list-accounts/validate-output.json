{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "users",
    "tokens"
  ],
  "properties": {
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "role",
          "provisioned",
          "access"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "user",
              "anonymous"
            ]
          },
          "provisioned": {
            "type": "boolean"
          },
          "access": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "topic",
                "permission",
                "provisioned"
              ],
              "properties": {
                "topic": {
                  "type": "string"
                },
                "permission": {
                  "enum": [
                    "read-write",
                    "read-only",
                    "write-only",
                    "deny"
                  ]
                },
                "provisioned": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "label",
          "expires",
          "last_access",
          "provisioned"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "username": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "expires": {
            "type": "string"
          },
          "last_access": {
            "type": "string"
          },
          "provisioned": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
