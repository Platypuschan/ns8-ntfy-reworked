#!/usr/bin/env python3

# NS8 restores the snapshot directory into ntfy-data. Place its contents at
# the normal ntfy paths before the restored service is configured.
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import ntfy_backup

ntfy_backup.restore_snapshot(os.environ["AGENT_STATE_DIR"])
