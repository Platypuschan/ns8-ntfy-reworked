import sys
import json
import agent

request = json.load(sys.stdin)

original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "TRAEFIK_LETS_ENCRYPT",
    ]:
    agent.set_env(evar, original_environment[evar])

# An older backup has no config/server.yml. Restore its legacy ntfy settings
# temporarily; configure-module migrates them to server.yml and removes them.
for evar in [
        "NTFY_BASE_URL",
        "NTFY_AUTH_DEFAULT_ACCESS",
        "NTFY_BEHIND_PROXY",
        "NTFY_ENABLE_LOGIN",
        "NTFY_ENABLE_SIGNUP",
        "NTFY_UPSTREAM_BASE_URE",
        "NTFY_UPSTREAM_BASE_URL",
        "NTFY_UPSTREAM_ACCESS_TOKEN",
        "NTFY_WEB_PUSH_EMAIL_ADDRESS",
        "NTFY_CACHE_FILE",
        "NTFY_ATTACHMENT_CACHE_DIR",
        "NTFY_AUTH_FILE",
        "NTFY_WEB_PUSH_FILE",
        "NTFY_WEB_PUSH_PUBLIC_KEY",
        "NTFY_WEB_PUSH_PRIVATE_KEY",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
