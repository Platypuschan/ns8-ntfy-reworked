import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import ntfy_config

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

previous = ntfy_config.read_server_config()
server_config = data.get("server_config")
if server_config is None:
    if not os.path.exists(ntfy_config.CONFIG_PATH):
        server_config = ntfy_config.default_config(data.get("host", ""))
    else:
        server_config = ntfy_config.editable_config(previous)
ntfy_config.write_server_config(ntfy_config.merge_configuration(
    server_config, previous, data.get("ios_push")
))
