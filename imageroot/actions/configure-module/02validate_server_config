import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import ntfy_config

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)
server_config = data.get("server_config")

# Reject a server.yml that ntfy cannot parse: the service would otherwise
# start, exit immediately and restart in a loop after a successful task.
if server_config is not None:
    error = ntfy_config.validate_server_config(server_config)
    if error:
        print(f"Invalid server_config: {error}", file=sys.stderr)
        agent.set_status('validation-failed')
        json.dump([{'field':'server_config','parameter':'server_config','value':'','error':'invalid_server_config'}],fp=sys.stdout)
        sys.exit(3)
