#!/usr/bin/env python3

# Run by ntfy-app.service before every start. During a module update the
# old service can be restarted with the new unit before update-module.d
# migrates the data; ntfy would then create empty databases in the volume
# and the migration would keep them instead of the real data. Moving the
# data here first rules that out. ntfy-app is not running at this point.
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import ntfy_migration

names = ntfy_migration.legacy_names()
if names:
    ntfy_migration.move_legacy_data(names)
