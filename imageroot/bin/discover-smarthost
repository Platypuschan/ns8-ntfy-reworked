import os
import re
import sys
import tempfile

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import ntfy_config


ENV_PATH = "smarthost.env"


def write_env(values):
    """Atomically write a private Podman environment file."""
    directory = os.path.dirname(ENV_PATH) or "."
    fd, temporary_path = tempfile.mkstemp(
        dir=directory,
        prefix=".smarthost.env.",
        text=True,
    )
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as stream:
            for key in sorted(values):
                value = str(values[key])
                if "\n" in value or "\r" in value:
                    raise ValueError(f"invalid newline in {key}")
                stream.write(f"{key}={value}\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, ENV_PATH)
    except Exception:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass
        raise


def fallback_sender(username, host):
    """Derive a usable sender address when server.yml does not define one."""
    username = str(username).strip()
    if re.fullmatch(r"[^@\s]+@[^@\s]+", username):
        return username
    host = str(host).strip()
    return f"no-reply@{host}" if host else ""


server_config = ntfy_config.read_server_config()

# An SMTP relay defined in server.yml takes precedence over the NS8 smarthost:
# injected NTFY_SMTP_* variables would otherwise override the file.
if ntfy_config.root_scalar(server_config, "smtp-sender-addr"):
    print(
        "smtp-sender-addr is defined in server.yml; the NS8 smarthost is not used",
        file=sys.stderr,
    )
    write_env({})
    sys.exit(0)

rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)

if not smtp.get("enabled") or not smtp.get("host"):
    write_env({})
    sys.exit(0)

# ntfy uses Go's net/smtp client. It supports plain SMTP and STARTTLS when the
# server advertises it, but it cannot connect to implicit SMTPS (usually 465).
if smtp.get("encrypt_smtp") == "tls":
    print(
        "<4>NS8 smarthost uses implicit TLS, which ntfy does not support; "
        "automatic SMTP configuration was skipped",
        file=sys.stderr,
    )
    write_env({})
    sys.exit(0)

if not smtp.get("tls_verify", True):
    print(
        "<4>NS8 smarthost disables TLS certificate verification, but ntfy "
        "always verifies SMTP certificates",
        file=sys.stderr,
    )

values = {
    "NTFY_SMTP_SENDER_ADDR": f'{smtp["host"]}:{smtp.get("port") or 25}',
}
if smtp.get("username"):
    values["NTFY_SMTP_SENDER_USER"] = smtp["username"]
if smtp.get("password"):
    values["NTFY_SMTP_SENDER_PASS"] = smtp["password"]

# smtp-sender-from is not part of the NS8 smarthost object. Preserve an
# explicit value in server.yml; otherwise prefer an email-shaped SMTP login
# and finally fall back to the public ntfy host.
if not ntfy_config.root_scalar(server_config, "smtp-sender-from"):
    sender = fallback_sender(
        smtp.get("username", ""),
        os.getenv("TRAEFIK_HOST", ""),
    )
    if sender:
        values["NTFY_SMTP_SENDER_FROM"] = sender

write_env(values)
